# Mau bien moi truong cua ShopLite (AD-31).
# Sao chep sang .env roi thay cac gia tri replace_me. Khong khai bao bien moi trong .env.local.

# PostgreSQL cai san tren may. Thay replace_me bang user Postgres (thuong la ket qua cua lenh whoami).
# Neu user co mat khau: postgresql://user:matkhau@localhost:5432/shoplite_dev
DATABASE_URL=postgresql://replace_me@localhost:5432/shoplite_dev

# Chi dung cho test:db va db:test:prepare. Ten database bat buoc la shoplite_test.
TEST_DATABASE_URL=postgresql://replace_me@localhost:5432/shoplite_test

# Khoa ky cookie Quyen xem don, toi thieu 32 byte. Tao bang: openssl rand -base64 32
ORDER_ACCESS_SECRET=replace_me

# Du lieu mau cho local, thay bang thong tin that truoc khi phat hanh.
SHOP_CONTACT_PHONE=0900000000
BANK_NAME="Ngan hang Demo"
BANK_ACCOUNT_NUMBER=0123456789

# Local dung 0 (bo dem IP chung). Production bat buoc la so nguyen tu 1 tro len.
TRUSTED_PROXY_HOPS=0

# Chi dung cho npm run staff:seed. Giu trong nhay don, chi chua hash, khong ghi mat khau ro.
# Tao hash bang npm run staff:hash (co sau Story 4.1). role la staff hoac manager.
STAFF_ACCOUNTS='[{"username":"thao","displayName":"Thao","role":"staff","passwordHash":"replace_me"},{"username":"khoa","displayName":"Khoa","role":"manager","passwordHash":"replace_me"}]'
