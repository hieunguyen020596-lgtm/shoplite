      "checkConstraints": {
        "osh_event_type_valid": {
          "name": "osh_event_type_valid",
          "value": "\"order_status_history\".\"event_type\" IN ('order_created', 'status_changed', 'refund_outcome_recorded')"
        },
        "osh_actor_type_valid": {
          "name": "osh_actor_type_valid",
          "value": "\"order_status_history\".\"actor_type\" IN ('customer', 'staff')"
        },
        "osh_from_status_valid": {
          "name": "osh_from_status_valid",
          "value": "\"order_status_history\".\"from_status\" IS NULL OR \"order_status_history\".\"from_status\" IN ('pending', 'confirmed', 'shipping', 'delivered', 'cancelled')"
        },
        "osh_to_status_valid": {
          "name": "osh_to_status_valid",
          "value": "\"order_status_history\".\"to_status\" IS NULL OR \"order_status_history\".\"to_status\" IN ('pending', 'confirmed', 'shipping', 'delivered', 'cancelled')"
        },
        "osh_refund_outcome_valid": {
          "name": "osh_refund_outcome_valid",
          "value": "\"order_status_history\".\"refund_outcome\" IS NULL OR \"order_status_history\".\"refund_outcome\" IN ('refunded', 'customer_not_transferred')"
        },
        "osh_staff_actor_required": {
          "name": "osh_staff_actor_required",
          "value": "\"order_status_history\".\"actor_type\" <> 'staff' OR \"order_status_history\".\"actor_staff_id\" IS NOT NULL"
        },
        "osh_event_shape": {
          "name": "osh_event_shape",
          "value": "(\n        \"order_status_history\".\"event_type\" = 'order_created'\n        AND \"order_status_history\".\"from_status\" IS NULL\n        AND \"order_status_history\".\"to_status\" = 'pending'\n        AND \"order_status_history\".\"reason_code\" IS NULL\n        AND \"order_status_history\".\"reason_text\" IS NULL\n        AND \"order_status_history\".\"refund_outcome\" IS NULL\n        AND \"order_status_history\".\"actor_type\" = 'customer'\n        AND \"order_status_history\".\"actor_staff_id\" IS NULL\n        AND \"order_status_history\".\"actor_name\" = 'Khách hàng'\n      ) OR (\n        \"order_status_history\".\"event_type\" = 'status_changed'\n        AND \"order_status_history\".\"from_status\" IS NOT NULL\n        AND \"order_status_history\".\"to_status\" IS NOT NULL\n        AND \"order_status_history\".\"refund_outcome\" IS NULL\n        AND \"order_status_history\".\"actor_type\" = 'staff'\n      ) OR (\n        \"order_status_history\".\"event_type\" = 'refund_outcome_recorded'\n        AND \"order_status_history\".\"refund_outcome\" IS NOT NULL\n        AND \"order_status_history\".\"from_status\" IS NOT NULL\n        AND \"order_status_history\".\"to_status\" IS NOT NULL\n        AND \"order_status_history\".\"reason_code\" IS NULL\n        AND \"order_status_history\".\"actor_type\" = 'staff'\n      )"
        }
